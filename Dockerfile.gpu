FROM mambaorg/micromamba:2.3.2

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Base HydroMap GPU environment.
COPY --chown=$MAMBA_USER:$MAMBA_USER environment.gpu.yml /tmp/environment.gpu.yml
RUN micromamba env create -y -f /tmp/environment.gpu.yml -n hydromap \
    && micromamba clean --all --yes

WORKDIR /workspace/HydroMap
COPY --chown=$MAMBA_USER:$MAMBA_USER . .

RUN micromamba run -n hydromap pip install --no-cache-dir -e . \
    && cd hydromap/triplets \
    && micromamba run -n hydromap python setup.py build_ext --inplace \
    && cp waterlib*.so "$(micromamba run -n hydromap python -c 'import site; print(site.getsitepackages()[0])')"/

ENV CUDA_PATH=/opt/conda/envs/hydromap/targets/x86_64-linux
ENV PATH=/opt/conda/envs/hydromap/bin:$PATH

USER $MAMBA_USER
CMD ["bash"]
